PORT=4000
FRONTEND_URL=http://localhost:5173

# Project Settings -> API in the Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co

# The "service_role" secret key -- NEVER the anon key, and NEVER commit the
# real value. This key bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack dashboard -> Settings -> API Keys & Webhooks -- the SECRET key
# (sk_test_... / sk_live_...), never the public one. Used server-side only,
# to verify a payment actually happened before upgrading a farm's plan.
PAYSTACK_SECRET_KEY=sk_test_your-secret-key

# Cloudinary dashboard -> Settings -> API Keys. The API secret is used
# server-side only, to sign upload requests -- never expose it in frontend
# code.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP creds for sending team-invite emails via Nodemailer. Easiest option:
# a Gmail account with a 16-character "App Password" (Google Account ->
# Security -> 2-Step Verification -> App passwords) -- NOT your normal
# Gmail password. host=smtp.gmail.com port=587 secure=false works for that.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-email@gmail.com
