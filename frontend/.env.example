VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The Express backend (backend/) -- used for the /admin panel and for
# verifying Paystack payments
VITE_BACKEND_API_URL=http://localhost:4000

# Paystack dashboard -> Settings -> API Keys & Webhooks -- the PUBLIC key
# (pk_test_... / pk_live_...). Safe to expose in frontend code.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key
